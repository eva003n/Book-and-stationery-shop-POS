generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model accounts {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @db.Uuid
  account_id               String    @unique
  provider_id              String
  access_token             String?
  refresh_token            String?
  access_token_expires_at  DateTime? @db.Timestamp(6)
  refresh_token_expires_at DateTime? @db.Timestamp(6)
  scope                    String?
  id_token                 String?
  password                 String?
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @default(now()) @db.Timestamp(6)
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_accounts_user_id")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invitations {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  email           String
  role            String
  status          String        @default("pending")
  expires_at      DateTime      @db.Timestamptz(6)
  inviter_id      String        @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  users           users         @relation(fields: [inviter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_invitations_email")
  @@index([inviter_id], map: "idx_invitations_inviter_id")
  @@index([organization_id], map: "idx_invitations_organization_id")
  @@index([status], map: "idx_invitations_status")
  @@schema("public")
}

model members {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?        @db.Uuid
  user_id         String?        @db.Uuid
  meta_data       Json?          @default("{}")
  role            String         @default("member")
  role_id         String?        @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles           roles?         @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model organizations {
  id                                                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                    String        @db.VarChar(100)
  email                                                   String        @unique @db.VarChar(200)
  kra_pin                                                 String?       @unique @db.VarChar(11)
  mpesa_short_code                                        Int?
  consumer_key                                            String?
  consumer_secret                                         String?
  schema_name                                             String        @unique @db.VarChar(63)
  plan                                                    String        @default("starter") @db.VarChar(50)
  meta_data                                               Json?         @default("{}")
  created_at                                              DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                              DateTime      @default(now()) @db.Timestamptz(6)
  invitations                                             invitations[]
  members                                                 members[]
  sessions_sessions_active_organization_idToorganizations sessions[]    @relation("sessions_active_organization_idToorganizations")
  sessions_sessions_tenant_idToorganizations              sessions[]    @relation("sessions_tenant_idToorganizations")

  @@schema("public")
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action           String             @db.VarChar(50)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]

  @@schema("public")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@schema("public")
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @default("member") @db.VarChar(50)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  members          members[]
  role_permissions role_permissions[]

  @@schema("public")
}

model sessions {
  id                                                           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                      String         @db.Uuid
  token                                                        String         @unique
  expires_at                                                   DateTime       @db.Timestamptz(6)
  ip_address                                                   String?
  user_agent                                                   String?
  active_organization_id                                       String?        @db.Uuid
  tenant_id                                                    String?        @db.Uuid
  schema_name                                                  String?        @db.VarChar(63)
  created_at                                                   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                                                   DateTime       @default(now()) @db.Timestamptz(6)
  organizations_sessions_active_organization_idToorganizations organizations? @relation("sessions_active_organization_idToorganizations", fields: [active_organization_id], references: [id], onUpdate: NoAction)
  organizations_sessions_tenant_idToorganizations              organizations? @relation("sessions_tenant_idToorganizations", fields: [tenant_id], references: [id], onUpdate: NoAction)
  users                                                        users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([active_organization_id], map: "idx_sessions_active_organization_id")
  @@index([expires_at], map: "idx_sessions_expires_at")
  @@index([user_id], map: "idx_sessions_user_id")
  @@schema("public")
}

model users {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name   String        @db.VarChar(100)
  email       String        @unique @db.VarChar(150)
  phone       String?       @unique @db.VarChar(20)
  password    String?       @db.VarChar(255)
  metadata    Json?         @default("{}")
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime?     @db.Timestamptz(6)
  accounts    accounts[]
  invitations invitations[]
  members     members[]
  sessions    sessions[]

  @@schema("public")
}

model verifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([expires_at], map: "idx_verifications_expires_at")
  @@index([identifier], map: "idx_verifications_identifier")
  @@schema("public")
}
